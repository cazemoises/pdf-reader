# NOTE: `npm ci` requires package-lock.json, which is only generated by
# running `npm install` locally at least once (deliberately not done as
# part of scaffolding - see README.md). Until a lockfile is committed,
# `docker build` on this directory will fail at the `npm ci` step.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null || exit 1
